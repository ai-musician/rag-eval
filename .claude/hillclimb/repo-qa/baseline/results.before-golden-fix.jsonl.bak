e-commands-for-any-failing-pod", "README#chaos-testing-losing-an-inference-pod-under-load", "TEST_PLAN#exit-criteria-testing-is-done"], "cited": ["K8S_RUNBOOK#crashloopbackoff", "K8S_RUNBOOK#oomkilled"], "expected": ["K8S_RUNBOOK#crashloopbackoff"], "answer": "Exit code 137 means the container was killed with SIGKILL. Most often this is OOMKilled: the container used more memory than its memory limit and the kernel killed it at once. Less often, it was killed after a failed liveness probe. To confirm an OOM kill, check `kubectl describe pod` for Last State: Terminated, Reason: OOMKilled, Exit Code: 137."}}
{"prompt_id": "oomkilled-confirm", "rep": 2, "prompt": "How do I confirm a pod was OOMKilled?", "tags": ["k8s-runbook", "answerable", "seed"], "status": "ok", "stop_reason": "end_turn", "grade": {"correct": 1.0, "grounded": 1.0, "abstain_ok": 1.0, "retrieval_hit": 1.0, "cited_ok": 1.0}, "explanation": {"correct": "The answer covers every key fact in the reference: describe pod showing Last State Terminated, Reason OOMKilled, Exit Code 137; the lastState.terminated.reason jsonpath; and comparing kubectl top with the memory limit. Every claim, including the metrics-server requirement, the events command, and the Evicted distinction, appears in the excerpts."}, "model": "claude-opus-5-5", "usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 2906, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 2906, "model": null, "output_tokens": 304, "type": "message"}], "output_tokens": 304, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "latency_s": 3.95, "judge_model": "claude-sonnet-5-5", "judge_usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 3307, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 3307, "model": null, "output_tokens": 141, "type": "message"}], "output_tokens": 141, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "meta": {"retrieved": ["K8S_RUNBOOK#kubernetes-troubleshooting-runbook-crashloopbackoff-and-oomk", "K8S_RUNBOOK#after-the-fix", "K8S_RUNBOOK#oomkilled", "K8S_RUNBOOK#first-three-commands-for-any-failing-pod", "K8S_RUNBOOK#crashloopbackoff"], "cited": ["K8S_RUNBOOK#oomkilled"], "expected": ["K8S_RUNBOOK#oomkilled"], "answer": "Run `kubectl --context kind-qa -n qa describe pod <pod>` and check Last State. An OOMKill shows `Terminated`, Reason `OOMKilled`, Exit Code 137. You can also read the reason directly with `kubectl get pod <pod> -o jsonpath='{.status.containerStatuses[*].lastState.terminated.reason}'` and check events with `get events --sort-by=.lastTimestamp`. To compare memory use with the limit, use `kubectl top pod <pod>` (needs metrics-server, current usage only) alongside the limit from `-o jsonpath='{.spec.containers[*].resources.limits.memory}'`. A pod marked `Evicted` was removed for node memory pressure, which is a different case from `OOMKilled`."}}
{"prompt_id": "logs-previous", "rep": 0, "prompt": "Why should I use kubectl logs with --previous on a failing pod?", "tags": ["k8s-runbook", "answerable", "drafted"], "status": "ok", "stop_reason": "end_turn", "grade": {"correct": 1.0, "grounded": 1.0, "abstain_ok": 1.0, "retrieval_hit": 1.0, "cited_ok": 1.0}, "explanation": {"correct": "The answer states that without --previous you see the new container that often hasn't failed yet, that the reason for the last death is in --previous, and that describe shows it under Last State. All of this matches the reference and is stated in the runbook excerpt."}, "model": "claude-opus-5-5", "usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 2585, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 2585, "model": null, "output_tokens": 161, "type": "message"}], "output_tokens": 161, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "latency_s": 3.45, "judge_model": "claude-sonnet-5-5", "judge_usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 2798, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 2798, "model": null, "output_tokens": 96, "type": "message"}], "output_tokens": 96, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "meta": {"retrieved": ["K8S_RUNBOOK#first-three-commands-for-any-failing-pod", "K8S_RUNBOOK#kubernetes-troubleshooting-runbook-crashloopbackoff-and-oomk", "K8S_RUNBOOK#oomkilled", "K8S_RUNBOOK#after-the-fix", "README#rolling-upgrades-releasing-under-load-p2"], "cited": ["K8S_RUNBOOK#first-three-commands-for-any-failing-pod"], "expected": ["K8S_RUNBOOK#first-three-commands-for-any-failing-pod"], "answer": "Without `--previous`, `kubectl logs` shows the new container, which often has not failed yet. The log of the container that just died, and so the reason it failed, is in `kubectl --context kind-qa -n qa logs <pod> --previous`. The runbook pairs this with `describe pod`, which shows that reason under **Last State**."}}
{"prompt_id": "logs-previous", "rep": 1, "prompt": "Why should I use kubectl logs with --previous on a failing pod?", "tags": ["k8s-runbook", "answerable", "drafted"], "status": "ok", "stop_reason": "end_turn", "grade": {"correct": 1.0, "grounded": 1.0, "abstain_ok": 1.0, "retrieval_hit": 1.0, "cited_ok": 1.0}, "explanation": {"correct": "The answer states the key facts: without --previous you see the new container that often hasn't failed yet, and the reason the last one died is in --previous and under Last State in describe. The OOMKilled caveat (SIGKILL, no last memory log line, Reason OOMKilled, exit code 137) is also supported by the excerpts."}, "model": "claude-opus-5-5", "usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 2585, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 2585, "model": null, "output_tokens": 230, "type": "message"}], "output_tokens": 230, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "latency_s": 3.27, "judge_model": "claude-sonnet-5-5", "judge_usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 2849, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 2849, "model": null, "output_tokens": 126, "type": "message"}], "output_tokens": 126, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "meta": {"retrieved": ["K8S_RUNBOOK#first-three-commands-for-any-failing-pod", "K8S_RUNBOOK#kubernetes-troubleshooting-runbook-crashloopbackoff-and-oomk", "K8S_RUNBOOK#oomkilled", "K8S_RUNBOOK#after-the-fix", "README#rolling-upgrades-releasing-under-load-p2"], "cited": ["K8S_RUNBOOK#first-three-commands-for-any-failing-pod", "K8S_RUNBOOK#oomkilled"], "expected": ["K8S_RUNBOOK#first-three-commands-for-any-failing-pod"], "answer": "Running `kubectl logs` without `--previous` shows the new container, which has often not failed yet. The reason the last container died is in the `--previous` log (the log of the container that just died) and in `kubectl describe pod` under **Last State**. One caveat for OOMKilled: the kernel kills the container at once with SIGKILL, so there's no last log line about memory and the log often looks normal right up to the end. In that case, check `describe` for Reason `OOMKilled` and exit code 137."}}
{"prompt_id": "oom-vs-eviction", "rep": 1, "prompt": "How is OOMKilled different from an eviction?", "tags": ["k8s-runbook", "answerable", "drafted"], "status": "ok", "stop_reason": "end_turn", "grade": {"correct": 1.0, "grounded": 1.0, "abstain_ok": 1.0, "retrieval_hit": 1.0, "cited_ok": 1.0}, "explanation": {"correct": "The answer covers all reference facts: OOMKilled is a container exceeding its memory limit, killed by the kernel with exit 137 and then restarted, while eviction is the kubelet removing whole pods under node memory pressure, shown as Evicted. The extra detail about Guaranteed QoS being evicted last is stated in the excerpts, so every claim is supported."}, "model": "claude-opus-5-5", "usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 2904, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 2904, "model": null, "output_tokens": 199, "type": "message"}], "output_tokens": 199, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "latency_s": 2.96, "judge_model": "claude-sonnet-5-5", "judge_usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "fallback_credit": null, "inference_geo": "global", "input_tokens": 3195, "iterations": [{"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "input_tokens": 3195, "model": null, "output_tokens": 142, "type": "message"}], "output_tokens": 142, "output_tokens_details": {"thinking_tokens": 0}, "server_tool_use": null, "service_tier": "standard", "speed": "standard"}, "meta": {"retrieved": ["K8S_RUNBOOK#oomkilled", "K8S_RUNBOOK#after-the-fix", "K8S_RUNBOOK#crashloopbackoff", "K8S_RUNBOOK#kubernetes-troubleshooting-runbook-crashloopbackoff-and-oomk", "K8S_RUNBOOK#first-three-commands-for-any-failing-pod"], "cited": ["K8S_RUNBOOK#oomkilled"], "expected": ["K8S_RUNBOOK#oomkilled"], "answer": "OOMKilled means a single container used more memory than its own memory limit, so the kernel killed it at once with SIGKILL. Kubernetes records Reason `OOMKilled` and exit code 137, then restarts the container. An eviction happens under node memory pressure: the kubelet evicts whole pods, which show status `Evicted`, not `OOMKilled`. Pods whose memory request equals their limit get the Guaranteed QoS class and are evicted last under node pressure."}}
